# Normalize text files and let Git manage platform-specific line endings
* text=auto

# Common text files
*.md text
*.py text
*.html text
*.css text
*.js text
*.json text
*.yml text
*.yaml text
*.txt text

# Shell scripts should use LF
*.sh text eol=lf

# Windows command script should us CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary